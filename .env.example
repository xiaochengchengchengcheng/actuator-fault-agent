# demo: no external model; openai-compatible: any OpenAI-compatible endpoint
MODEL_MODE=demo
MODEL_NAME=gpt-4.1-mini
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TEMPERATURE=0

# memory for local demo; sqlite/postgres can be wired for durable deployments
CHECKPOINTER=memory
SQLITE_PATH=data/runtime/checkpoints.sqlite

KNOWLEDGE_DIR=knowledge
MOCK_TELEMETRY_PATH=data/mock_telemetry.json
RETRIEVAL_TOP_K=5
MIN_EVIDENCE_SCORE=0.08
HUMAN_REVIEW_RISK_LEVEL=high

# Optional shared secret for POST /v1/alarms/events.
# Leave empty for the local demo. Set it in production and send X-Alarm-Token.
ALARM_WEBHOOK_TOKEN=

